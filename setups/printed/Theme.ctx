% ------------------------------------------------------------
% Theme.ctx - Centralized Color Definitions for ConTeXt (LMTX)
%
% Define and manage all project colors in one place to keep
% styles consistent. Update color values here instead of
% searching through multiple files or environments.
%
% Usage:
%   \input{Theme.ctx}
%   Use defined colors (colBackground, colMaintext, colHeader)
%   across your document.
% ------------------------------------------------------------

% ----- TitlePage.ctx -----
\definecolor[MainTitleText]    [c=0, m=0, y=0, k=0.90] % Almost black - deep for main title text
\definecolor[MainTitleStart]   [c=0.15, m=0.85, y=0.65, k=0.10] % Luxurious burgundy for gradient start
\definecolor[MainTitleEnd]     [c=0.05, m=0.35, y=0.80, k=0.15] % Warm classic gold for gradient end

% ----- MasterLayout.ctx -----
\definecolor[ColBackground]    [c=0, m=0, y=0, k=0]       % Pure white for paper background
\definecolor[ColMaintext]      [c=0, m=0, y=0, k=0.85]    % Soft black for main readable text
\definecolor[ColHeader]        [c=0.72, m=0.22, y=0, k=0.15]   % Luxury royal blue for headers
\definecolor[ColFooter]        [c=0.72, m=0.22, y=0, k=0.35]   % Darker royal blue for footers
\definecolor[ColImportant]     [c=0, m=0.70, y=0.85, k=0.05]   % Vibrant vermilion for important highlights

% ----- Setups.ctx -----
\definecolor[ColHashtag]       [c=0.55, m=0.15, y=0.85, k=0.10] % Modern jade green for hashtags
\definecolor[ColItemizeHorizontal] [c=0.75, m=0.25, y=0.30, k=0.10] % Teal gray for horizontal item lists


