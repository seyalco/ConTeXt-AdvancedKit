% ======================================
% This file contains:
% 1. Main font definition
% 2. Additional fonts used throughout the document
% ======================================

%========== 1. Main Font Definition  ==========%
% ----- GLOBAL FONT SETTINGS  -----
\setvariables
  [fontsetup]
  [fontfile=m-Parastoo-VariableFont_wght.ttf,
    scale=1]
  
\definefontfeature [regular]    [axis={wght=400}]
\definefontfeature [medium]     [axis={wght=500}]
\definefontfeature [semibold]   [axis={wght=600}]
\definefontfeature [bold]       [axis={wght=700}]

% ----- TYPEFACE DEFINE  -----
\starttypescript [serif] [parastoo]
  \setups[fallbackfonts] % Load fallback definitions
  
  \definefontsynonym [SerifRegular] [file:\getvariable{fontsetup}{fontfile}] [features={FarsiParstoo,regular}]
  \definefontsynonym [SerifMedium] [file:\getvariable{fontsetup}{fontfile}] [features={FarsiParstoo,medium}]
  \definefontsynonym [SerifSemiBold] [file:\getvariable{fontsetup}{fontfile}] [features={FarsiParstoo,semibold}]
  \definefontsynonym [SerifBold] [file:\getvariable{fontsetup}{fontfile}] [features={FarsiParstoo,bold}]
\stoptypescript

% ----- BODY FONT SIZE / WEIGHT MAPPING-----
\starttypescript [serif] [parastoo]
  \definebodyfont [default] [rm]
    [
      tf=SerifRegular   sa \getvariable{fontsetup}{scale},
      md=SerifMedium    sa \getvariable{fontsetup}{scale},
      sb=SerifSemiBold  sa \getvariable{fontsetup}{scale},
      bf=SerifBold      sa \getvariable{fontsetup}{scale},
    ]
\stoptypescript

% ----- NAMED TYPEFACE -----
\starttypescript [parastoo]
  \definetypeface [parastoo] [rm] [serif] [parastoo] [default] [fallbacks=myfallback]
\stoptypescript

% ----- APPLY BODY FONT -----
\setupbodyfont[parastoo]

%========== 2. Other Fonts ==========%
% Definition of other fonts used in the text:
%\definefont [FontHeader]    [file:Nahid.ttf*default at 10pt] %It's just an example
\definefont[FontHeader][SerifMedium sa 0.7]
\definefont[FontFooter][SerifRegular sa 1]
\definefont[FontImportant][SerifMedium sa 1]
