% set dimension variables for S4 paper size
% For the first part of each variable name, always use the ‘size:’ prefix.
% This makes it immediately clear throughout the document that the variable belongs to the ‘size’ file/configuration.

%Setups.ctx
%%paper size
\setvariable{size:paper}{papersize}{S4}

%%Horizontal Item
\setvariable{size:horizontal-itemize}{number-columns}{three}

%%Poem
\setvariable{size:poem}{number-columns}{two}
