% ======================================
% This file contains:
% 1. Main font definition for Lora Variable Font
% 2. Additional named fonts used throughout the document
% ======================================

%========== 1. Main Font Definition  ==========%
% ----- GLOBAL FONT SETTINGS  -----
\setvariables
  [fontsetup]
  [fontfile=m-Lora-VariableFont_wght.ttf,
    scale=0.8]

% ----- VARIABLE FONT WEIGHTS -----
\definefontfeature [regular]    [axis={wght=400}]
\definefontfeature [medium]     [axis={wght=500}]
\definefontfeature [semibold]   [axis={wght=600}]
\definefontfeature [bold]       [axis={wght=700}]

% ----- TYPEFACE DEFINE -----
\starttypescript [serif] [lora]
  \setups[fallbackfonts] % Load fallback definitions
  
  \definefontsynonym [SerifRegular]    [file:\getvariable{fontsetup}{fontfile}] [features={EnglishLora,regular}]
  \definefontsynonym [SerifMedium]     [file:\getvariable{fontsetup}{fontfile}] [features={EnglishLora,medium}]
  \definefontsynonym [SerifSemiBold]   [file:\getvariable{fontsetup}{fontfile}] [features={EnglishLora,semibold}]
  \definefontsynonym [SerifBold]       [file:\getvariable{fontsetup}{fontfile}] [features={EnglishLora,bold}]
\stoptypescript

% ----- BODY FONT SIZE / WEIGHT MAPPING -----
\starttypescript [serif] [lora]
  \definebodyfont [default] [rm]
    [
      tf=SerifRegular    sa \getvariable{fontsetup}{scale},
      md=SerifMedium     sa \getvariable{fontsetup}{scale},
      sb=SerifSemiBold   sa \getvariable{fontsetup}{scale},
      bf=SerifBold       sa \getvariable{fontsetup}{scale},
    ]
\stoptypescript

% ----- NAMED TYPEFACE -----
\starttypescript [lora]
  \definetypeface [lora] [rm] [serif] [lora] [default] [fallbacks=myfallback]
\stoptypescript

% ----- APPLY BODY FONT -----
\setupbodyfont[lora]

%========== 2. Other Fonts ==========%
% Definition of other fonts used in the text:
\definefont[FontHeader][SerifMedium sa 0.7]
\definefont[FontFooter][SerifRegular sa 1]
\definefont[FontImportant][SerifSemiBold sa 0.9]

