% -*- coding: utf-8 -*-
% Portable Fonts Loader for ConTeXt — GitHub Version
% --------------------------------------------------
% This script automatically loads local fonts from the `Common-Sources/FontCollection` 
% directory and all its subdirectories, without requiring them to be installed system-wide.
% The script is fully portable across Windows, Linux, and macOS.
%
% Difference from basic version:
%   - Automatically detects the **project root** by searching parent directories
%     until a unique file `Generate-Outputs.py` is found.
%   - Works even if `main.ctx` is located in a nested subdirectory of the project.
%
% Usage:
%   - Place this script in your ConTeXt document or in a preloaded environment file.
%   - Ensure your project contains:
%       ProjectRoot/
%           Common-Sources/
%               FontCollection/
%           Generate-Outputs.py
%   - Fonts in `FontCollection` will be loaded automatically by ConTeXt.
%

%%[lua] start
\startluacode
local lfs = require("lfs") -- LuaFileSystem for directory handling

-- Choose path separator depending on OS
-- Windows => ";"   |   Unix-like => ":"
local sep = package.config:sub(1, 1) == "\\" and ";" or ":"

-- Function to find the project root directory by searching
-- upward from the starting directory until 'Generate-Outputs.py' is found.
local function find_project_root(start_dir)
    local current_dir = start_dir
    while true do
        local target_file = current_dir .. "/Generate-Outputs.py"
        local attr = lfs.attributes(target_file, "mode")
        if attr == "file" then
            -- Found the file — this is the project root
            return current_dir
        end
        -- Move one level up or stop if already at filesystem root
        local parent_dir = current_dir:match("(.+)/[^/]+$")
        if not parent_dir or parent_dir == current_dir then
            return nil -- Reached top without finding project root
        end
        current_dir = parent_dir
    end
end

-- Get current working directory of ConTeXt execution
local start_dir = lfs.currentdir()
local project_dir = find_project_root(start_dir)

-- Error handling if the project root cannot be found
if not project_dir then
    texio.write_nl("term", "[ERROR] Could not locate project root containing 'Generate-Outputs.py'")
    return
end

-- Path to the main font directory inside the project
local main_font_dir = project_dir .. "/Common-Sources/FontCollection"

-- Recursive function to collect all font directories
local function collect_subdirs(dir, list)
    if lfs.attributes(dir, "mode") == "directory" then
        table.insert(list, dir) -- Add current directory to list
        for entry in lfs.dir(dir) do
            if entry ~= "." and entry ~= ".." then
                local fullpath = dir .. "/" .. entry
                if lfs.attributes(fullpath, "mode") == "directory" then
                    collect_subdirs(fullpath, list) -- Go deeper
                end
            end
        end
    end
end

-- Gather all directories containing fonts
local font_paths = {}
collect_subdirs(main_font_dir, font_paths)

-- Build OSFONTDIR environment variable so ConTeXt can resolve fonts
local existing = os.getenv("OSFONTDIR") or ""
local new_path = table.concat(font_paths, sep)
if existing ~= "" then
    new_path = new_path .. sep .. existing
end

os.setenv("OSFONTDIR", new_path)

-- Reset ConTeXt's font resolver cache
if resolvers and resolvers.resetfonts then
    resolvers.resetfonts()
end

-- Debug mode (optional):
-- Uncomment to list all added font paths:
-- for _, p in ipairs(font_paths) do
--    print("Added font path:", p)
-- end
\stopluacode
%%[lua] stop

%% -------------------------------------------------------------------
%% Example usage inside your ConTeXt document:
%%
%% \starttext
%% \definedfont[Nahid.ttf*default]
%% This text uses Nahid.ttf from your portable font collection!
%% \stoptext
%% -------------------------------------------------------------------

