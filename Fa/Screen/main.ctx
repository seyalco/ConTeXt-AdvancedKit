\input{PathList.ctx}
\input{FontsLoader.ctx}
% ===========================
%  تنظیمات فونت متغیر (Variable Font)
% ===========================
\setvariables
  [fontsetup]
  [
    fontfile=PTSans-Regular.ttf,
    light=300,
    regular=400,
    medium=500,
    semibold=600,
    bold=700,
    extrabold=800,
    scale=1
  ]

% ===========================
%  تعریف typescript برای فونت Parastoo
% ===========================
\starttypescript [serif] [parastoo]

  % --- فونت‌های synonym با وزن‌های مختلف ---
  \definefontsynonym [SerifLight]
    [file:\getvariable{fontsetup}{fontfile}]
    [features={default}, axis={wght=\getvariable{fontsetup}{light}}]

  \definefontsynonym [SerifRegular]
    [file:\getvariable{fontsetup}{fontfile}]
    [features={default}, axis={wght=\getvariable{fontsetup}{regular}}]

  \definefontsynonym [SerifMedium]
    [file:\getvariable{fontsetup}{fontfile}]
    [features={default}, axis={wght=\getvariable{fontsetup}{medium}}]

  \definefontsynonym [SerifSemiBold]
    [file:\getvariable{fontsetup}{fontfile}]
    [features={default}, axis={wght=\getvariable{fontsetup}{semibold}}]

  \definefontsynonym [SerifBold]
    [file:\getvariable{fontsetup}{fontfile}]
    [features={default}, axis={wght=\getvariable{fontsetup}{bold}}]

  \definefontsynonym [SerifExtraBold]
    [file:\getvariable{fontsetup}{fontfile}]
    [features={default}, axis={wght=\getvariable{fontsetup}{extrabold}}]

  % --- نقشه وزن‌ها برای متن اصلی ---
  \definebodyfont [default] [rm]
    [
      lt=SerifLight     sa \getvariable{fontsetup}{scale},
      tf=SerifRegular   sa 1,
      md=SerifMedium    sa \getvariable{fontsetup}{scale},
      sb=SerifSemiBold  sa \getvariable{fontsetup}{scale},
      bf=SerifBold      sa \getvariable{fontsetup}{scale},
      eb=SerifExtraBold sa \getvariable{fontsetup}{scale},
    ]

  % --- نسخه Italic (فعلاً fallback به Regular) ---
  \definebodyfont [default] [it]
    [
      tf=SerifRegular sa \getvariable{fontsetup}{scale},
    ]

\stoptypescript

% ===========================
%  تعریف typeface و فعال‌سازی
% ===========================
\starttypescript [parastoo]
  \definetypeface [parastoo] [rm] [serif] [parastoo] [default]
\stoptypescript

\setupbodyfont[parastoo]

% ===========================
%  نمونه استفاده
% ===========================
\starttext
sghl
سلام
\stoptext

