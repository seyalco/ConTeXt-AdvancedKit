% ======================================
% This file contains:
% 1. Main font definition for Vazirmatn Variable Font
% 2. Additional named fonts used throughout the document
% ======================================

%========== 1. Main Font Definition  ==========%
% ----- GLOBAL FONT SETTINGS  -----
\setvariables
  [fontsetup]
  [fontfile=m-Vazirmatn_wght.ttf,
    scale=0.9]

% ----- VARIABLE FONT WEIGHTS -----
\definefontfeature [thin]       [axis={wght=100}]
\definefontfeature [extralight] [axis={wght=200}]
\definefontfeature [light]      [axis={wght=300}]
\definefontfeature [regular]    [axis={wght=400}]
\definefontfeature [medium]     [axis={wght=500}]
\definefontfeature [semibold]   [axis={wght=600}]
\definefontfeature [bold]       [axis={wght=700}]
\definefontfeature [extrabold]  [axis={wght=800}]
\definefontfeature [black]      [axis={wght=900}]

% ----- TYPEFACE DEFINE -----
\starttypescript [serif] [vazirmatn]
  \setups[fallbackfonts] % Load fallback definitions
  
  \definefontsynonym [SerifThin]       [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,thin}]
  \definefontsynonym [SerifExtraLight] [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,extralight}]
  \definefontsynonym [SerifLight]      [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,light}]
  \definefontsynonym [SerifRegular]    [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,regular}]
  \definefontsynonym [SerifMedium]     [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,medium}]
  \definefontsynonym [SerifSemiBold]   [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,semibold}]
  \definefontsynonym [SerifBold]       [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,bold}]
  \definefontsynonym [SerifExtraBold]  [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,extrabold}]
  \definefontsynonym [SerifBlack]      [file:\getvariable{fontsetup}{fontfile}] [features={FarsiVazirmatn,black}]
\stoptypescript

% ----- BODY FONT SIZE / WEIGHT MAPPING -----
\starttypescript [serif] [vazirmatn]
  \definebodyfont [default] [rm]
    [
      th=SerifThin       sa \getvariable{fontsetup}{scale},
      el=SerifExtraLight sa \getvariable{fontsetup}{scale},
      lt=SerifLight      sa \getvariable{fontsetup}{scale},
      tf=SerifRegular    sa \getvariable{fontsetup}{scale},
      md=SerifMedium     sa \getvariable{fontsetup}{scale},
      sb=SerifSemiBold   sa \getvariable{fontsetup}{scale},
      bf=SerifBold       sa \getvariable{fontsetup}{scale},
      eb=SerifExtraBold  sa \getvariable{fontsetup}{scale},
      bk=SerifBlack      sa \getvariable{fontsetup}{scale},
    ]
\stoptypescript

% ----- NAMED TYPEFACE -----
\starttypescript [vazirmatn]
  \definetypeface [vazirmatn] [rm] [serif] [vazirmatn] [default] [fallbacks=myfallback]
\stoptypescript

% ----- APPLY BODY FONT -----
\setupbodyfont[vazirmatn]

%========== 2. Other Fonts ==========%
% Definition of other fonts used in the text:
\definefont[FontHeader][SerifMedium sa 0.7]
\definefont[FontFooter][SerifRegular sa 1]
\definefont[FontImportant][SerifSemiBold sa 0.9]
