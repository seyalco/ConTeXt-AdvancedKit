% set dimension variables for A5 paper size
%در اسم اول هر متغیر حتما از پیشوند size: استفاده کنید تا در سرتاسر سند بلافاصله مشخص باشد این مربوط به فایل size هست.

%Setups.ctx
%%paper size
\setvariable{paper}{size}{A5}

%%Itemize
\getvariable{itemize-horizontal}{number-columns}{three}

%%Poem
\setvariable{poem}{number-columns}{two}
