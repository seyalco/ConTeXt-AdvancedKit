% =========================================
% File: Setups.ctx
% Purpose: General template settings
% =========================================

% ---------- Document Direction ------------
\setupdirections
  [
    bidi=\getvariable{dir:document}{bidi_init},
    method=\getvariable{dir:document}{bidi_method},
  ]

\setupalign 
   [\getvariable{dir:document}{direction}]

% Use these environments for a major block of text whose direction is opposite
% to the main document's flow (e.g., an English section in a Persian book).
\definestartstop[LTR] 
  [before={\begingroup\lefttoright},after=\endgroup]

\definestartstop[RTL]
   [before={\begingroup\righttoleft},after=\endgroup]


% ---------- General Settings ------------
\setupinteraction
    [state=start]

\setuppapersize
    [\getvariable{size:paper}{papersize}]
    
\setupuserpagenumber
    [numberconversion=\getvariable{lang:document}{page_number}]

%to change the Hyphenation rules, quotation marks, all that sort of thing, to that of a different language:
\mainlanguage[\getvariable{lang:document}{language}]

% ---------- Paragraph & Line Spacing ----
\setupwhitespace          % Paragraph spacing
    [halfline]        
    
\setupinterlinespace      % Line spacing
    [line=3.4ex]   
    
\setuptolerance
    [tolerant]
    

% ---------- Defined Highlights ----------
\definehighlight [Important]
     [style=FontImportant, color=ColImportant]

% ---------- fancy subject ----------

\definehead [fancysubject] 
    [subject]      

\setuphead [fancysubject]  
  [
    align=center,  
    style=\bfc,    
    before={\blank[big]},  
    after={\blank[2*big]},
  ]

% ---------- Hashtag ----------
\startluacode
interfaces.implement {
    name      = "Hashtag",   
    public    = true,   
    protected = true,  
    arguments = "string",    -- Expects one string argument
    actions   = function(str) 
      str = string.gsub(str," ","_")     -- Replace spaces with underscores
      context.bgroup()                
        context.nohyphens()            -- Prevent  breaking in middle
        context.startcolor({"ColHashtag"})    -- Set text color
        context.letterhash()              -- Print hashtag symbol
        context(str)                           -- Print processed string
        context.stopcolor()               -- End text color
      context.egroup()                
    end
}
\stopluacode
% Usage example: \Hashtag{your text}
% This will output: #your_text


% ---------- Horizontal Item List --------
\defineconversion [custom-horizontal-item]
  [
    \getvariable{lang:custom-horizontal-item}{n1},
    \getvariable{lang:custom-horizontal-item}{n2},
    {\symbol[U_Faces:smile_square]},
    {\symbol[Fruits:grape]}
  ]

\defineitemgroup [Horizontal]

\setupitemgroup [Horizontal]
  [each]
  [ 
    custom-horizontal-item,
    packed,
    columns,
    \getvariable{size:horizontal-itemize}{number-columns},
  ]
  [
    color=ColItemizeHorizontal,
    command=\Important, %%Importan Highlight that we defined
    direction={\getvariable{dir:itemize}{direction}},
    stopper=,
    leftmargin=5mm,
    before=\blank[2*medium],
    after=\blank[medium],
  ]

% ----------Theorem Environment -----
\defineenumeration[theorem]
   [
    headalign=\getvariable{dir:theorem}{headalign},
    alternative=text,
    text=\getvariable{lang:theorem}{text},
    numberconversion=\getvariable{lang:theorem}{numberconversion},
    title=yes,
   ]
    
% ---------- Dual-Poem Environment -----
\defineitemgroup[Mypoem]
\setupitemgroup[Mypoem]
  [1] % Setup for the first level of the itemization
  [
    horizontal,
    \getvariable{size:poem}{number-columns}, %One, Two or Even numbers
  ]
  [
    symbol=,
    before={\blank[medium]\startcolor[ColImportant]},
    after={\blank[medium]\stopcolor},
  ]
  
 \protected\def\hemistich#1
   {\startitem #1\stopitem}
  
% =========================================
% END OF FILE
% =========================================
